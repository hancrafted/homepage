{
  "name": "homepage",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "knip": "knip",
    "wiki:index": "node scripts/build-wiki-index.mjs",
    "wiki:index:check": "node scripts/build-wiki-index.mjs --check",
    "prepare": "husky",
    "verify": "archgate check && eslint . && prettier --check . && tsc --noEmit && vitest run && knip && mh --check && npm run wiki:index:check",
    "verify:commit": "lint-staged && archgate check && tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hancrafted/markdown-harness": "^0.0.5",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "archgate": "^0.55.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.7",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0"
  }
}
